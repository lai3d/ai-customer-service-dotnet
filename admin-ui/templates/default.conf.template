# Rendered by the nginx image's envsubst step at container start. ADMIN_API_UPSTREAM is the
# service the UI's /api is proxied to: `app:8082` in the Compose stack, the API's Service
# name in Kubernetes. Deploying the UI without the proxy means serving the bundle from any
# static host and enabling CORS on the service (ADMIN_CORS_ORIGINS).
server {
    listen 8083;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Declared inside each location, not at server level: nginx does not inherit add_header
    # into a location that sets one of its own, which is how a policy goes missing from /
    # while the config file reads correctly.
    set $csp "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'";

    location /api/ {
        proxy_pass http://${ADMIN_API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        # No customer text is cached anywhere on this hop.
        add_header Cache-Control "no-store" always;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy $csp always;
    }
}
