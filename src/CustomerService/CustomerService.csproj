<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CustomerService</RootNamespace>
    <AssemblyName>CustomerService</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UserSecretsId>ai-customer-service-dotnet</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- Providers. The official SDKs, and nothing between them and the turn: one Stream
         call is one model call is one bill. -->
    <PackageReference Include="Anthropic" Version="12.46.0" />
    <PackageReference Include="OpenAI" Version="2.13.0" />
    <!-- Retrieval: the embedding model runs in this process. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <!-- Observability. -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The demo page is embedded rather than served from disk: one binary, no asset
         path to get wrong in a container. -->
    <EmbeddedResource Include="web/index.html" LogicalName="web/index.html" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CustomerService.Tests" />
  </ItemGroup>
</Project>
