# Copy to .env and fill in. .env is gitignored.
#
# Only the key for the selected provider is needed; startup fails immediately if it is
# missing, rather than reporting healthy and 401ing every customer request.

# 8082 deliberately: the Java implementation of this system uses 8080, the Go one 8081,
# and all three stacks are expected to run on one machine.
HTTP_ADDR=:8082

CHAT_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-opus-5

# CHAT_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-5

# CHAT_PROVIDER=xai
XAI_API_KEY=
# XAI_CHAT_MODEL=grok-4.6

# Gemini is deliberately absent: this implementation supports three providers, and
# documenting a variable that nothing reads is worse than not documenting it. The Java
# implementation of this system supports it -- see docs/providers.md.

# --- Postgres -----------------------------------------------------------------------
# Deliberately not 5432 or 5433: the sibling implementations run their own stacks on
# those, and Compose projects cannot share a host port.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=csagent
POSTGRES_USER=csagent
POSTGRES_PASSWORD=csagent

# --- Shutdown -----------------------------------------------------------------------
# How long in-flight turns get to finish after SIGTERM. Compose's stop_grace_period and the
# pod's terminationGracePeriodSeconds must both stay above it. Found missing here by the
# test that compares this file with the Kubernetes ConfigMap.
SHUTDOWN_GRACE=30s

# --- Cost ---------------------------------------------------------------------------
# A conversation is an open-ended bill unless capped. 0 disables the cap.
CONVERSATION_TOKEN_BUDGET=200000

# --- Embedding ----------------------------------------------------------------------
# How many callers may be inside the native embedding call at once. 0 means the
# processor count. See docs/retrieval.md.
EMBEDDING_MAX_CONCURRENCY=0
# Threads ONNX Runtime may use inside one forward pass. 1 is a measurement: the default is
# the core count, and under concurrent queries that oversubscribes the cores. 0 restores
# the runtime's default. See docs/benchmark.md.
EMBEDDING_INTRA_OP_THREADS=1

# --- Tracing ------------------------------------------------------------------------
# Off unless a collector is running, so `make run` on its own does not fill the log
# with failed exports. `docker compose up` turns it on.
OTLP_TRACING_EXPORT_ENABLED=false
OTLP_TRACING_ENDPOINT=http://localhost:4320
TRACING_SAMPLE_RATE=1.0
# A support question is often the most sensitive thing in a request, and traces are
# retained and read widely. On only while debugging retrieval.
TRACE_INCLUDE_QUERY_CONTENT=false

# --- Logging ------------------------------------------------------------------------
# Debug adds one line per model call with its usage, which is how the frame counts in
# docs/reliability.md were checked.
LOG_LEVEL=Information

# --- Operations admin ---------------------------------------------------------------
# The admin API is never registered unless enabled: /api/admin/v1/* is a 404 the way any
# unknown path is, not a 401 from a guard. The UI is a separate container on 8083.
ADMIN_ENABLED=false
# Create the first admin at startup, only into an empty staff_account table. Both or
# neither; the password must be at least 12 characters. Safe to leave set afterwards.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
# Idle timeout of a staff session.
ADMIN_SESSION_TIMEOUT=30m
# Only when the UI is served from another origin than the API (a Vite dev server on 5173,
# a separate static host). The Compose stack proxies /api through nginx and needs none.
ADMIN_CORS_ORIGINS=
